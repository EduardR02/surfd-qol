{
  "manifest_version": 3,
  "name": "Surfd QoL",
  "version": "1.3.1",
  "description": "Custom HUD, per-tick surf feedback, start splits, PB/WR checkpoint speeds and a native crouch-jump binding.",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "storage"],
  "host_permissions": ["https://surfd.net/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Surfd QoL — connect or reload observer" },
  "content_scripts": [
    { "matches": ["https://surfd.net/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://surfd.net/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ]
}
